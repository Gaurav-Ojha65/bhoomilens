# Copy to .env before deploying. .env is gitignored.
# Populate the resource IDs after each `cdk deploy` from CloudFormation outputs.

# --- AWS ---
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=

# --- Resources (populated after `cdk deploy`) ---
DOCUMENTS_BUCKET=
RECORDS_TABLE=bhoomilens-records
AUDIT_TABLE=bhoomilens-audit
REFERENCE_TABLE=bhoomilens-reference
API_ENDPOINT=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_IDENTITY_POOL_ID=

# --- Bedrock (verify ACTIVE at deploy time via `aws bedrock list-foundation-models`) ---
BEDROCK_MODEL_ID_PRIMARY=PLACEHOLDER_VERIFY_ACTIVE
BEDROCK_MODEL_ID_FALLBACK=PLACEHOLDER_VERIFY_ACTIVE
BEDROCK_REGION=ap-south-1

# --- OCR ---
OCR_MODE=paddleocr
OCR_LANGUAGES=hi,en

# --- Confidence policy (see docs/VALIDATION_RULES.md) ---
CONFIDENCE_WEIGHT_OCR=0.40
CONFIDENCE_WEIGHT_EXTRACTION=0.30
CONFIDENCE_WEIGHT_VALIDATION=0.30
THRESHOLD_AUTO_APPROVE=90
THRESHOLD_NEEDS_REVIEW=70
FORCE_REVIEW_ON_HIGH_SEVERITY=true

# --- CORS (tighten after first deploy) ---
CORS_ALLOWED_ORIGIN=*
