{
  "name": "bhoomilens-infrastructure",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "bhoomilens": "bin/bhoomilens.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "cdk": "cdk",
