    "deploy:api": "cdk deploy BhoomiLens-Api"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "aws-cdk": "^2.135.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.135.0",
    "constructs": "^10.3.0"
  }
}
